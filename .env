# Directory in which all the code, virtual environments, and data should be stored.
export MILABENCH_BASE=/tmp/milabench/base/
# Path to configuration file that represents the benchmark suite(s) to run.
export MILABENCH_CONFIG=config/all.yaml
# The architecture of the GPUs of the system ['rocm', 'hpu', 'cpu', 'xpu', 'cuda']
export MILABENCH_GPU_ARCH=cuda
# Select a specific benchmark to run
export MILABENCH_SELECT_BENCH=dqn
# Reduce stdout report verbosity
export MILABENCH_REPORT_LEAN=1
